{
  "name": "Sponsorship",
  "type": "object",
  "properties": {
    "donorId": {
      "type": "string"
    },
    "donorName": {
      "type": "string"
    },
    "beneficiaryId": {
      "type": "string"
    },
    "beneficiaryName": {
      "type": "string"
    },
    "startDate": {
      "type": "string",
      "format": "date"
    },
    "endDate": {
      "type": "string",
      "format": "date"
    },
    "monthlyAmount": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "ended",
        "paused"
      ],
      "default": "active"
    }
  },
  "required": [
    "donorId",
    "beneficiaryId",
    "startDate"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    }
  }
}